<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".admin">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#C0EAFA"
        tools:context=".HomeActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <androidx.cardview.widget.CardView
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:layout_margin="35dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="20dp">

                <ImageView
                    android:id="@+id/adhoplogo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:src="@drawable/logo" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="15dp"
                    android:elevation="10dp"
                    android:gravity="center"
                    android:text="HOPSTACK"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <GridLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:layout_gravity="center"
                    android:rowCount="2">

                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_margin="15dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="20dp">


                        <ImageView
                            android:id="@+id/adattedanceimg"
                            android:layout_width="100dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/app_name"
                            app:srcCompat="@drawable/attendance" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="1dp"
                            android:elevation="10dp"
                            android:gravity="center"
                            android:text="ATTENDANCE"/>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_margin="15dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="20dp">


                        <ImageView
                            android:id="@+id/adQRimg"
                            android:layout_width="100dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/app_name"
                            app:srcCompat="@drawable/scanner" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="1dp"
                            android:elevation="10dp"
                            android:gravity="center"
                            android:text="GENERATE QR"/>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_margin="15dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="20dp">


                        <ImageView
                            android:id="@+id/adprofileimg"
                            android:layout_width="100dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/app_name"
                            app:srcCompat="@drawable/profile" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:id="@+id/profiletext"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="1dp"
                            android:elevation="10dp"
                            android:gravity="center"
                            android:text="PROFILES"/>

                    </androidx.cardview.widget.CardView>



                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_margin="15dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="20dp">


                        <ImageView
                            android:id="@+id/adgrievanceimg"
                            android:layout_width="106dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/app_name"
                            app:srcCompat="@drawable/grievance" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:id="@+id/greviencetxt"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="1dp"
                            android:elevation="10dp"
                            android:gravity="center"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:text="GREVIENCES"/>

                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_margin="15dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="20dp">


                        <ImageView
                            android:id="@+id/adreportimg"
                            android:layout_width="100dp"
                            android:layout_height="90dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/app_name"
                            android:layout_marginBottom="10dp"
                            android:layout_marginTop="10dp"
                            app:srcCompat="@drawable/standstrong" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="1dp"
                            android:elevation="10dp"
                            android:gravity="center"
                            android:text="RAGGING REPORTS"/>

                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_margin="15dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="20dp">


                        <ImageView
                            android:id="@+id/adhostelvibeimg"
                            android:layout_width="100dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/app_name"
                            app:srcCompat="@drawable/hostelvibes" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="1dp"
                            android:elevation="10dp"
                            android:gravity="center"
                            android:text="MEMORIES"/>

                    </androidx.cardview.widget.CardView>

                </GridLayout>
            </LinearLayout>





        </LinearLayout>

    </ScrollView>


</LinearLayout>
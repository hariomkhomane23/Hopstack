<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#C0EAFA"
    tools:context=".Grievance">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="25dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="40dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="15dp"
        android:backgroundTint="#F3F4F6">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="600dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Grievance"
                android:textSize="24sp"
                android:textColor="@color/white"
                android:background="@drawable/logbg"
                android:backgroundTint="@color/navyblue"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:layout_marginBottom="20dp"/>

            <!-- Username Field -->
            <EditText
                android:id="@+id/username"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/logbg"
                android:drawableLeft="@drawable/baseline_person_24"
                android:drawablePadding="10dp"
                android:hint="Username"
                android:layout_marginTop="15dp"
                android:paddingHorizontal="15dp"
                android:textColor="@color/black"
                android:layout_marginBottom="20dp"/>

            <!-- Enrollment No Field -->
            <EditText
                android:id="@+id/enno"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/logbg"
                android:drawableLeft="@drawable/baseline_list_24"
                android:drawablePadding="10dp"
                android:hint="Enrollment No"
                android:paddingHorizontal="15dp"
                android:textColor="@color/black"
                android:layout_marginBottom="20dp"/>


            <!-- Comment Field -->
            <EditText
                android:id="@+id/comment"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="@drawable/logbg"
                android:drawableLeft="@drawable/baseline_comment_24"
                android:drawablePadding="10dp"
                android:hint="Comment"
                android:inputType="textMultiLine"
                android:paddingHorizontal="15dp"
                android:gravity="left|center"
                android:textColor="@color/black"
                android:layout_marginBottom="20dp"/>

            <!-- Upload Photo Button -->
            <Button
                android:id="@+id/button2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#8E41FB"
                android:text="Upload Photo"
                android:layout_marginBottom="20dp"/>

            <!-- Submit Button -->
            <Button
                android:id="@+id/submit"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/navyblue"
                android:textColor="@color/white"
                android:background="@drawable/logbg"
                android:text="Submit"
                android:layout_gravity="center"
                android:textSize="18sp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="30dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>

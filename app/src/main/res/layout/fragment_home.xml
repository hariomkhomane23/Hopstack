<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    tools:context=".ui.home.HomeFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#C0EAFA"
        tools:context=".HomeActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:layout_margin="35dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="20dp">

                <ImageView
                    android:id="@+id/hoplogo"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:src="@drawable/logo" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="15dp"
                    android:elevation="10dp"
                    android:gravity="center"
                    android:text="HOPSTACK"/>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <GridLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2">

                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_margin="15dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="20dp">

                        <ImageView
                            android:id="@+id/attedanceimg"
                            android:layout_width="100dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/app_name"
                            app:srcCompat="@drawable/attendance" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="1dp"
                            android:elevation="10dp"
                            android:gravity="center"
                            android:text="ATTEDANCE"/>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_margin="15dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="20dp">


                        <ImageView
                            android:id="@+id/scannerimg"
                            android:layout_width="100dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/app_name"
                            app:srcCompat="@drawable/scanner" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="1dp"
                            android:elevation="10dp"
                            android:gravity="center"
                            android:text="SCANNER"/>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_margin="15dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="20dp">


                        <ImageView
                            android:id="@+id/myprofile"
                            android:layout_width="100dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/app_name"
                            app:srcCompat="@drawable/profile" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:id="@+id/profiletext"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="1dp"
                            android:elevation="10dp"
                            android:gravity="center"
                            android:text="PROFILE"/>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_margin="15dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="20dp">


                        <ImageView
                            android:id="@+id/paymentimg"
                            android:layout_width="106dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/app_name"
                            app:srcCompat="@drawable/payment" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:id="@+id/paymenttext"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="1dp"
                            android:elevation="10dp"
                            android:gravity="center"

                            android:text="PAYMENT"/>

                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_margin="15dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="20dp">


                        <ImageView
                            android:id="@+id/rulesimg"
                            android:layout_width="106dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/app_name"
                            app:srcCompat="@drawable/rules" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:id="@+id/rulestext"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="1dp"
                            android:elevation="10dp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:text="RULES"/>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_margin="15dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="20dp">


                        <ImageView
                            android:id="@+id/grievanceimg"
                            android:layout_width="106dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/app_name"
                            app:srcCompat="@drawable/grievance" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:id="@+id/greviencetxt"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="1dp"
                            android:elevation="10dp"
                            android:gravity="center"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:text="GREVIENCE"/>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_margin="15dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="20dp">


                        <ImageView
                            android:id="@+id/mindspeakimg"
                            android:layout_width="100dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="2dp"
                            android:contentDescription="@string/app_name"
                            app:srcCompat="@drawable/mindspeak" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:id="@+id/mindspeaktxt"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="1dp"
                            android:elevation="10dp"
                            android:gravity="center"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:text="MINDSPEAK"/>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_margin="15dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="20dp">


                        <ImageView
                            android:id="@+id/standstrongimg"
                            android:layout_width="100dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="3dp"
                            android:contentDescription="@string/app_name"
                            app:srcCompat="@drawable/standstrong" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:id="@+id/standstrongtxt"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="1dp"
                            android:elevation="10dp"
                            android:gravity="center"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:text="STANDSTRONG"/>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_margin="15dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="20dp">


                        <ImageView
                            android:id="@+id/hostelvibeimg"
                            android:layout_width="100dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="2dp"
                            android:contentDescription="@string/app_name"
                            app:srcCompat="@drawable/hostelvibes" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:id="@+id/hostelvibetxt"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="1dp"
                            android:elevation="10dp"
                            android:gravity="center"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:text="HOSTELVIBE"/>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_margin="15dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="20dp">


                        <ImageView
                            android:id="@+id/legacyhubimg"
                            android:layout_width="100dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:layout_marginBottom="2dp"
                            android:contentDescription="@string/app_name"
                            app:srcCompat="@drawable/legacyhub" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:id="@+id/legacyhubtxt"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="1dp"
                            android:elevation="10dp"
                            android:gravity="center"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:text="LEGACYHUB"/>

                    </androidx.cardview.widget.CardView>




                </GridLayout>
            </LinearLayout>




        </LinearLayout>

    </ScrollView>

</LinearLayout>